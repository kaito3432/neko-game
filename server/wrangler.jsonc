{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "nyan-chase-online",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "alias": {"node-fetch": "./apple-node-fetch.mjs"},
  "triggers": {"crons": ["0 * * * *"]},
  "vars": {
    "NYAN_ENVIRONMENT": "production",
    "ADMOB_REWARDED_AD_UNIT_IDS": "ca-app-pub-6462457361541481/4339169364,ca-app-pub-6462457361541481/5638651041",
    "MASTER_REWARD_PERIODS": "{\"2026-09\":\"cat_master_s01_king\"}"
  },

  "durable_objects": {
    "bindings": [
      {"name": "ONLINE_PLAYERS", "class_name": "OnlinePlayers"},
      {
        "name": "GAME_ROOMS",
        "class_name": "GameRoom"
      }
    ]
  },

  "exports": {
    "OnlinePlayers": {"type": "durable-object", "storage": "sqlite"},
    "GameRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
